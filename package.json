{
  "name": "dtrw-app-z15a",
  "version": "1.17.4",
  "repository": "git@github.com:burtek/dtrw-app-z15a.git",
  "author": "Bartosz <burtekdotryw@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 yarn workspaces foreach -Api -j 2 run start:dev",
    "build": "cross-env FORCE_COLOR=1 yarn workspaces foreach -Ap run build",
    "lint": "cross-env FORCE_COLOR=1 yarn workspaces foreach -Ap run lint",
    "test": "vitest run",
    "prepare": "husky",
    "release": "standard-version"
  },
  "standard-version": {
    "bumpFiles": [
      "package.json",
      "packages/backend/package.json",
      "packages/frontend/package.json"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
